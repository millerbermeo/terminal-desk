{
  "manifest_version": 3,
  "name": "Odesk Code · Chrome",
  "short_name": "Odesk",
  "version": "1.0.0",
  "description": "Deja que el Asistente de Odesk Code (y los asistentes conectados a Odesk) use tu Chrome: solo en las pestañas del grupo «Odesk» y en los sitios que autorices.",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "tabs", "tabGroups", "storage", "alarms"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Odesk Code",
    "default_popup": "popup.html",
    "default_icon": { "16": "iconos/icono-16.png", "32": "iconos/icono-32.png", "48": "iconos/icono-48.png", "128": "iconos/icono-128.png" }
  },
  "icons": { "16": "iconos/icono-16.png", "32": "iconos/icono-32.png", "48": "iconos/icono-48.png", "128": "iconos/icono-128.png" }
}
