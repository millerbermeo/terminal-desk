<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 (JIT) de Electron bajo el runtime endurecido. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Módulos nativos de terceros (node-pty, onnxruntime, sharp) firmados por otros. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Las terminales y el CLI de Claude heredan variables como DYLD_* de nvm/Homebrew. -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- Dictado, notas de voz y llamadas del chat. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Servidor de tareas (socket local), chat y API. -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
  </dict>
</plist>
