{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["node"],
    "paths": { "@shared/*": ["./src/shared/*"] }
  },
  "include": ["src", "tests", "evals", "electron.vite.config.ts", "vitest.config.mts", "vitest.evals.config.mts"]
}
